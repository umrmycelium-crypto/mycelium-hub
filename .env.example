# Mycelium Hub Environment Configuration
# Copy this file to .env and update values for your environment

# ============================================
# LLM Backend Configuration
# ============================================
# The model to use for Ollama-based LLM inference
# Common models: qwen2.5-coder:latest, llama2, mistral
# Set this before running services that use ask_llm()
MYCELIUM_OLLAMA_MODEL=qwen2.5-coder:latest

# ============================================
# Service Endpoints
# ============================================
# Optional: Override these if your services are on different machines
# JELLYFIN_URL=http://10.0.0.221:8096
# OVERSEERR_URL=http://localhost:5055
# RADARR_URL=http://localhost:7878
# SONARR_URL=http://localhost:8989
# OLLAMA_URL=http://localhost:11434

# ============================================
# Daemon Server
# ============================================
# Host and port for the daemon server (used by dashboard)
# DAEMON_HOST=0.0.0.0
# DAEMON_PORT=8000

# ============================================
# Dashboard
# ============================================
# Host and port for the dashboard
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=8082
